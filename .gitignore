# Virtual environments
venv/
.venv/
env/

# Everything the tools regenerate: the mypy, ruff, pytest and Hypothesis caches, coverage data
# and reports, and the downloaded HaGRID annotations. One folder, safe to delete at any time.
.cache/

# Python bytecode and packaging output (pip writes the egg-info when installing the project)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Tool caches in their default places, in case a tool is run without the project's settings
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Dataset images: rebuilt from HaGRID by src/crop_hagrid_hands.py (folders kept via .gitkeep)
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png

# Unseen-subject evaluation images, rebuilt by `python -m src.audit_hagrid_lineage --external 500`
dataset_external/**/*.jpg

# Weights trained by the architecture study (the frozen checkpoint is never among them)
model/studies/

# Generated by the check scripts and `model_study.py --quick`; regenerate on demand
reports/qa/
reports/model_study_quick.json
