# Virtual environment
venv/
.venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Trained model artifacts and training checkpoints
# (the model/ folder itself is kept via model/.gitkeep)
model/*.h5
model/*.keras
model/*.tflite
model/checkpoints/
logs/
*.ckpt
*.pb

# Collected dataset images — the folder structure is tracked, the images are not
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Cached HaGRID parquet shards (re-downloadable, never committed)
.hagrid_cache/
