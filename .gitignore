# Virtual environments
venv/
.venv/
env/

# Python bytecode, packaging and build output
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Tool caches and local test output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Dataset images: rebuilt from HaGRID by src/crop_hagrid_hands.py (folders kept via .gitkeep)
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png

# Unseen-subject evaluation images, rebuilt by `python -m src.audit_hagrid_lineage --external 500`
dataset_external/**/*.jpg

# Downloaded HaGRID annotations and the lineage audit's crop-hash cache (re-downloadable)
.hagrid_cache/

# Weights trained by the architecture study (the frozen checkpoint is never among them)
model/studies/

# Generated by the check scripts and `model_study.py --quick`; regenerate on demand
reports/qa/
reports/model_study_quick.json
