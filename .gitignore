# Virtual environment
venv/
.venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Trained model artifacts and training checkpoints
# (the model/ folder itself is kept via model/.gitkeep)
model/*.h5
model/*.keras
model/*.tflite
model/checkpoints/
logs/
*.ckpt
*.pb

# Collected dataset images — the folder structure is tracked, the images are not
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Cached HaGRID parquet shards (re-downloadable, never committed)
.hagrid_cache/

# Unseen-subject evaluation images, rebuilt by `python -m src.audit_hagrid_lineage --external`
dataset_external/**/*.jpg

# Weights trained by the architecture study (the frozen checkpoint is never among them)
model/studies/

# Regenerated by check_dataset.py / check_data_pipeline.py - QA sheets, not source of truth
augmentation_sample_grid.jpg
augmentation_updown_grid.jpg
dataset_sample_grid.jpg
updown_orientation_grid.jpg

# Output of `model_study.py --quick`, superseded by reports/model_study.json
reports/model_study_quick.json

# Tool caches and local test output
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
