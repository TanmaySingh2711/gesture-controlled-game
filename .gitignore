# The virtual environment built by install.py
venv/

# Everything the tools regenerate - mypy, ruff, pytest and Hypothesis caches, coverage data and
# reports, QA image sheets, study weights, downloaded HaGRID annotations, the crop staging
# folder. One folder, safe to delete at any time.
.cache/

# Python bytecode
__pycache__/

# Images: rebuilt from HaGRID, never stored in git. The class folders are filled by
# src/crop_hagrid_hands.py and dataset/external/ by `python -m src.audit_hagrid_lineage --external 500`.
dataset/**/*.jpg

# Editor and operating-system files
.vscode/
.DS_Store
Thumbs.db
